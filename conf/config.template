[exchanges]
    ex1: 
        [settings]
        key=value #settings

        [profiles]
            profile_name_1:    
                api_name=<apikey-name> #credentials
                api_secret=<apikey-secret> #credentials 
                        
    ex2:
    
        [settings]
        key=value #settings

        [profiles]
            profile_name_2:
                {ex2_credents.ini} # load credentials from external file


[accounts]
    acc1: 
        profile=profile_name_1@ex1
        
        [query]
        market=spot
        currency=USD
    
    acc2:
        profile=profile_name_2@ex2
        
        [query]
        market=futures
        currency=USDT
        
[instruments]
    Bitcoin:
        source=ex1
        
        [query]
        symbol=BTCUSD
    
    Special:
        source=profile_name_1@ex1
        
        [query]
        symbol=SPEC

[strategies]
    Label:
        name=<strategy_name_in_module>
        instruments= Bitcoin,Special
        accounts= acc1,acc2
        
        [configuration]
        key=value
            
         