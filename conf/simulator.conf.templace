[replay]
    r1:
        file=bitcoin_replay.csv
        speed=1     #multiply each timestamp by this number
        offset=0    #add number to timestamp (seconds)
    
    r2:
        file=bitcoin_replay.csv
        speed=1
        offset=0
        

[simulator]
    realtime=true/false

[accounts]
    acc1:
        balance=1000
        currency=USD
        
[instruments]
    Bitcoin:
        symbol=BTCUSD
        type=spot
        tick_size=0.01
        lot_size=0.0001
        lot_multiplier=1
        min_size=0.0001,
        min_volume=0,
        quanto_factor=1
        initial_margin=1
        maintenance_margin=1
        tradable=true
        can_short=true
        currency=USD                    
    

[strategies]
    Name:
        module=module.so
        instruments= Bitcoin,Special
        accounts= acc1,acc2
        
        [configuration]
        key=value
            
         